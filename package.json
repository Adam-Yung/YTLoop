{
  "name": "ytloop",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-platform Playwright YouTube same-channel watcher",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node src/main.js",
    "probe": "node scripts/probe.js",
    "test": "playwright test --project=unit --project=fixture",
    "test:live": "LIVE=1 playwright test --project=live",
    "lint": "node scripts/check-style.js && node scripts/check-docs.js",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@playwright/test": "^1.50.0"
  }
}
